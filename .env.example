# Copy this file to .env and fill in your own values. Never commit .env.

# LLM provider: "gemini" (free tier), "anthropic", or "openai"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Vector store — sentence-transformers embeddings run locally, no API cost
VECTOR_DB_PATH=./data/chroma_store
EMBEDDING_MODEL=all-MiniLM-L6-v2

# App
APP_ENV=development
LOG_LEVEL=INFO
